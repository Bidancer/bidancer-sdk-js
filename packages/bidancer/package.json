{
    "description": "Official Bidancer SDK for JavaScript: report influencer-campaign conversions from your server or browser.",
    "engines": {
        "node": ">=18"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        },
        "./browser": {
            "import": "./dist/browser.js",
            "require": "./dist/browser.cjs",
            "types": "./dist/browser.d.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "homepage": "https://bidancer.com/docs/developers/sdk-js",
    "keywords": [
        "bidancer",
        "influencer",
        "affiliate",
        "conversion",
        "tracking",
        "sdk"
    ],
    "license": "MIT",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "name": "bidancer",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "directory": "packages/bidancer",
        "type": "git",
        "url": "https://github.com/Bidancer/bidancer-sdk-js.git"
    },
    "scripts": {
        "build": "bun run build.ts",
        "test": "bun test"
    },
    "sideEffects": [
        "./dist/bidancer-track.js"
    ],
    "type": "module",
    "types": "./dist/index.d.ts",
    "version": "0.1.0"
}
